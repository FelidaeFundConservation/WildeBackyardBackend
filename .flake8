[flake8]
# Exclude template files and other generated/third-party code
exclude =
    venv,
    .venv,
    migrations,
    staticfiles,
    gcp_deployment/templates,
    __pycache__,
    .git,
    .tox,
    build,
    dist

# Error codes to check for syntax errors and undefined names
select = E9,F63,F7,F82

# Maximum line length
max-line-length = 127

# Maximum complexity
max-complexity = 10
