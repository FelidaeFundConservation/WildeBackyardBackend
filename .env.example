# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True

# Host Configuration
# Note: Staging and local development environments automatically allow all hosts.
# Production requires specific WEBSITE_HOSTNAME configuration.
HOST_NAME=localhost

# Database Configuration
DB_NAME=wildebackyard
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Google Cloud Storage
GCS_BUCKET_NAME=wildepod_backyard

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key

# Mapbox
MAPBOX_SECRET_TOKEN=your-mapbox-token

# Django Account Settings
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
