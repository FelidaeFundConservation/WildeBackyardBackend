# Bandit configuration file to exclude test files from security checks
# Use glob patterns to exclude test files and directories

exclude_dirs:
  - '*/tests'
  - '*/migrations'
  - 'venv'
  - 'staticfiles'
  - '.venv'

# Exclude test files using glob patterns
exclude: 
  - '*/test_*.py'
  - '*_test.py'
  - 'tests.py'

# Skip these test IDs that commonly appear in test code
skips: ['B101', 'B601', 'B602', 'B603', 'B605', 'B607']
